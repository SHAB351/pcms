# ---------------------------------------------------------------------------
# PCMS — variables d'environnement
#
# Copiez ce fichier en « .env.local » puis renseignez les valeurs.
#   Windows (PowerShell) : Copy-Item .env.example .env.local
# « .env.local » n'est jamais commité.
# ---------------------------------------------------------------------------

# --- Supabase (obligatoire) -------------------------------------------------
# Supabase Dashboard > Project Settings > API
# URL du projet, par exemple https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique « anon » / « publishable ». Elle est exposée au navigateur,
# ce qui est normal : les accès sont contrôlés par les politiques RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NE JAMAIS exposer cette clé au frontend (aucun préfixe NEXT_PUBLIC_).
# Utilisée uniquement par des scripts serveur d'administration.
# Laissez vide si vous n'en avez pas besoin.
SUPABASE_SERVICE_ROLE_KEY=

# --- Assistant IA (optionnel) ----------------------------------------------
# Fournisseur utilisé par src/lib/ai/registry.ts.
# Valeurs possibles : « mock » (hors ligne, par défaut) ou « openai-compatible ».
AI_PROVIDER=mock

# Clé d'API du fournisseur. Rester côté serveur uniquement.
AI_API_KEY=

# Identifiant du modèle à utiliser chez le fournisseur.
AI_MODEL=

# Racine de l'API compatible OpenAI, sans « /chat/completions » :
#   OpenAI        https://api.openai.com/v1
#   Mistral       https://api.mistral.ai/v1
#   Groq          https://api.groq.com/openai/v1
#   Ollama local  http://localhost:11434/v1      <- reste sur le poste
AI_BASE_URL=

# Autorisation GLOBALE d'envoyer du contenu à un service externe.
# Refusée tant que la valeur n'est pas exactement « true ». Un AI_BASE_URL
# local (localhost, 127.0.0.1) n'a pas besoin de cette autorisation : le
# contenu ne quitte pas la machine.
AI_ALLOW_EXTERNAL=false

# Délai maximal d'un appel au fournisseur, en millisecondes.
AI_TIMEOUT_MS=60000

# --- Comptes de test (local uniquement, jamais commité) ---------------------
# Utilisés par « npm run verify:documents » pour éprouver les politiques RLS.
# Créer trois comptes confirmés dans le tableau de bord Supabase, puis élever
# les rôles en SQL (voir README, « Créer le premier administrateur »).
PCMS_TEST_ADMIN_EMAIL=
PCMS_TEST_ADMIN_PASSWORD=
PCMS_TEST_EDITOR_EMAIL=
PCMS_TEST_EDITOR_PASSWORD=
PCMS_TEST_READER_EMAIL=
PCMS_TEST_READER_PASSWORD=
