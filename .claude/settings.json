{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Bash(git push:*)",
      "Bash(git remote add:*)",
      "Bash(vercel:*)",
      "Bash(npx vercel:*)",
      "Bash(supabase db push:*)",
      "Bash(npx supabase:*)",
      "Bash(npm publish:*)",
      "Bash(npm run deploy:*)"
    ]
  }
}
